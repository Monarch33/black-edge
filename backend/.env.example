# Black Edge Backend Configuration
# ================================

# API Configuration
DEBUG=false
API_HOST=0.0.0.0
API_PORT=8000

# Polygon RPC Configuration (Alchemy recommended for production)
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
POLYGON_WS_URL=wss://polygon-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
ALCHEMY_API_KEY=your_alchemy_api_key_here

# Polymarket API
POLYMARKET_API_URL=https://gamma-api.polymarket.com
POLYMARKET_API_KEY=your_polymarket_api_key_if_needed

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/blackedge

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Firebase Configuration
FIREBASE_CREDENTIALS_PATH=/path/to/firebase-credentials.json

# Email Service Configuration (Resend)
# Sign up at https://resend.com for free API key
RESEND_API_KEY=re_your_resend_api_key_here

# LLM Configuration
# Anthropic (primary — used by Oracle)
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here
# OpenAI (optional fallback)
OPENAI_API_KEY=sk-your_openai_api_key_here
# Model override (defaults to claude-sonnet-4-5)
LLM_MODEL=claude-sonnet-4-5

# Oracle — AI Prediction Pipeline (oracle.py)
ORACLE_DRY_RUN=true                  # true = simulate trades; false = live execution
ORACLE_MIN_EDGE=0.15                 # Minimum LLM-vs-market edge to trigger a trade (15%)
ORACLE_MIN_CONFIDENCE=0.80           # Minimum LLM confidence score
ORACLE_MAX_POSITION_USDC=50.0        # Maximum USDC per single oracle trade
ORACLE_BANKROLL_FRACTION=0.05        # Kelly fraction cap (5% of bankroll per trade)
ORACLE_LOOP_INTERVAL_SECS=300        # How often the oracle re-scans (seconds)
ORACLE_MARKETS_LIMIT=30              # Number of non-crypto markets to evaluate per cycle
# Optional: real news context providers (leave blank to use mock context)
NEWSAPI_KEY=                         # https://newsapi.org
PERPLEXITY_API_KEY=                  # https://www.perplexity.ai/api

# Polymarket execution credentials (for oracle live mode)
POLYMARKET_PRIVATE_KEY=0x_your_polygon_wallet_private_key
POLYMARKET_API_KEY=your_polymarket_api_key
POLYMARKET_SECRET=your_polymarket_secret
POLYMARKET_PASSPHRASE=your_polymarket_passphrase

# Arbitrage Parameters
MIN_PROFIT_THRESHOLD=0.05
MAX_POSITION_PROBABILITY=0.95

# Security
JWT_SECRET_KEY=your_jwt_secret_key_here_change_in_production
CORS_ORIGINS=http://localhost:3000,https://blackedge.io
