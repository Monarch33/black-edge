# Black Edge Production Configuration
# ====================================
# Set these in Vercel Environment Variables dashboard
# This file only contains non-secret defaults

# Backend API URL (set the real value in Vercel dashboard)
# NEXT_PUBLIC_API_URL=https://your-backend.up.railway.app

# Polymarket API
NEXT_PUBLIC_POLYMARKET_API=https://gamma-api.polymarket.com

# Analytics
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=auto
